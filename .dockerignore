# Admit only the inputs needed to calculate, test, and build the application.
**
!Dockerfile
!.dockerignore
!requirements.txt
!main.py

!data/
!data/nodes.parquet
!data/edges.parquet
!data/transactions.parquet

!apps/
!apps/backend/
!apps/backend/requirements.txt
!apps/backend/moneygraph/
!apps/backend/moneygraph/*.py

!apps/frontend/
!apps/frontend/package.json
!apps/frontend/package-lock.json
!apps/frontend/.oxlintrc.json
!apps/frontend/index.html
!apps/frontend/tsconfig*.json
!apps/frontend/vite.config.ts
!apps/frontend/vitest.agent.config.ts
!apps/frontend/components.json
!apps/frontend/src/
!apps/frontend/src/**
!apps/frontend/public/
!apps/frontend/public/**
!apps/frontend/server/
!apps/frontend/server/*.mjs
!apps/frontend/server/*.mts
!apps/frontend/scripts/
!apps/frontend/scripts/*.mjs
!apps/frontend/scripts/*.py
!apps/frontend/scripts/graph-qa/
!apps/frontend/scripts/graph-qa/*.mjs

# Export fresh project data inside the build; exclude local credentials everywhere.
apps/frontend/public/project-data.json
apps/frontend/public/.project-data.json.*.tmp
**/.env
**/.env.*
**/*.key
**/*.pem
**/node_modules
**/__pycache__
**/*.pyc
**/.DS_Store
