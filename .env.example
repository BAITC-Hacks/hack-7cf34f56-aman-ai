# Copy to .env at repository root. Never commit populated keys.
# The deterministic UI works without any model API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Use the same data mode for the UI and agent.
VITE_DATA_MODE=project
# Set both URLs when the teammate's analytical API is ready.
VITE_API_BASE_URL=http://127.0.0.1:8000
ANALYTICS_API_BASE_URL=http://127.0.0.1:8000

# Production deployment examples. server/production.mjs does NOT load this file.
# Set these in the host's runtime environment (Render Environment), not build args.
# Local Docker Compose provides its own loopback-only public-access configuration.
APP_ACCESS_MODE=password
APP_ACCESS_USER=judge
# Required for password mode: at least 16 characters. Render Blueprint generates it.
APP_ACCESS_PASSWORD=
# Optional custom HTTPS origin; blank uses Render's RENDER_EXTERNAL_URL automatically.
APP_ORIGIN=
# Shared across all users of one process; resets on restart, not a hard cost cap.
AGENT_REQUESTS_PER_HOUR=20
HOST=0.0.0.0
PORT=3000
